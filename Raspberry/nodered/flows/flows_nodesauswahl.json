  {
    "id": "fn-parse-nodesauswahl",
    "type": "function",
    "z": "tab-opcua-nodesauswahl",
    "name": "NodesAuswahl parsen",
    "func": "const text = String(msg.payload || \"\");\nconst lines = text.split(/\\r?\\n/);\n\nfunction stationKey(name) {\n    return String(name || \"unbekannt\")\n        .toLowerCase()\n        .trim()\n        .replace(/[^a-z0-9]+/g, \"_\")\n        .replace(/^_+|_+$/g, \"\");\n}\n\nfunction topicTagFromNodeId(nodeId) {\n    const m = String(nodeId).match(/^ns=\\d+;s=(.*)$/);\n    if (!m) return String(nodeId).replace(/[^A-Za-z0-9]+/g, \"_\");\n    const raw = m[1].replace(/^\"+|\"+$/g, \"\");\n    return raw\n        .replace(/[^A-Za-z0-9]+/g, \"_\")\n        .replace(/^_+|_+$/g, \"\");\n}\n\nlet stationName = \"unbekannt\";\nconst items = [];\nconst seen = new Set();\n\nfor (const rawLine of lines) {\n    const line = rawLine.trim();\n    if (!line) continue;\n\n    if (line.startsWith(\"#\")) {\n        stationName = line.replace(/^#+/, \"\").trim() || stationName;\n        continue;\n    }\n\n    const m = line.match(/^(\\d+\\.\\d+\\.\\d+\\.\\d+:\\d+)\\s+(ns=\\d+;[sigb]=[^\\s]+)\\s+([A-Za-z0-9]+)$/i);\n    if (!m) continue;\n\n    const endpoint = m[1];\n    const nodeId = m[2].trim();\n    const datatype = m[3].trim();\n    const station = stationKey(stationName);\n    const tag = topicTagFromNodeId(nodeId);\n\n    const dedupKey = `${endpoint}|${nodeId}`;\n    if (seen.has(dedupKey)) continue;\n    seen.add(dedupKey);\n\n    items.push({ endpoint, nodeId, datatype, station, tag });\n}\n\nflow.set(\"nodesAuswahlItems\", items);\nmsg.payload = { loaded: items.length };\nnode.status({ fill: \"green\", shape: \"dot\", text: `${items.length} Nodes geladen` });\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 760,
    "y": 120,
    "wires": [
      [
        "debug-config-loaded"
      ]
    ]
  },
