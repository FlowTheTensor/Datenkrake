    {
        "id": "fn-normalize-value",
        "type": "function",
        "z": "tab-opcua-nodesauswahl",
        "name": "Wert normalisieren + MQTT-Topic",
        "func": "let value = msg.payload;\n\nif (Array.isArray(value) && value.length > 0) {\n const first = value[0];\n if (first && typeof first === \"object\" && first.value !== undefined) {\n value = first.value;\n } else {\n value = first;\n }\n} else if (value && typeof value === \"object\" && value.value !== undefined) {\n value = value.value;\n}\n\nif (!msg.station) {\n msg.station = String(msg.endpoint || \"unbekannt\").replace(/[:.]/g, \"_\");\n}\n\nif (!msg.tag && msg.nodeId) {\n const m = String(msg.nodeId).match(/^ns=\\d+;s=(.*)$/);\n const rawTag = m ? m[1].replace(/^\"+|\"+$/g, \"\") : String(msg.nodeId);\n msg.tag = rawTag.replace(/[^A-Za-z0-9]+/g, \"_\").replace(/^_+|_+$/g, \"\");\n}\n\nmsg.payload = value;\nmsg.topic = `plc/${msg.station}/${msg.tag || \"unknown\"}`;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1820,
        "y": 520,
        "wires": [
            [
                "rbe-only-changes"
            ]
        ]
    },
    {
        "id": "rbe-only-changes",
        "type": "function",
        "z": "tab-opcua-nodesauswahl",
        "name": "Aenderungsfilter (typabhaengig)",
        "func": "// Deadband (Mindestabweichung) fuer numerische Analogwerte.\n// Bei Bedarf pro Tag anpassen, z.B. wenn ein Fuellstand staerker rauscht als ein anderer.\nconst DEFAULT_DEADBAND = 35;\n\n// Optional: abweichende Schwellwerte fuer einzelne Tags (Key = \"station/tag\")\nconst DEADBAND_OVERRIDES = {\n    // \"palettenlager1/AN_BL2_F_llstand\": 15,\n    // \"palettenlager2/AM_BL1_F_llstand\": 15,\n};\n\n// Datentypen, die als \"analog/numerisch\" behandelt werden (Deadband statt exakter Gleichheit)\nconst ANALOG_TYPES = new Set([\n    \"Int16\", \"UInt16\", \"Int32\", \"UInt32\", \"Int64\", \"UInt64\",\n    \"Float\", \"Double\", \"Real\"\n]);\n\nconst key = msg.topic; // eindeutig durch station+tag (siehe fn-normalize-value)\nconst datatype = msg.datatype;\nconst value = msg.payload;\n\n// Letzte Werte pro Topic im flow-Kontext vorhalten\nlet lastValues = flow.get(\"lastValues\") || {};\nconst hadPrevious = Object.prototype.hasOwnProperty.call(lastValues, key);\nconst prevValue = lastValues[key];\n\nlet isChange = false;\n\nif (!hadPrevious) {\n    // Erster Wert fuer dieses Topic: immer durchlassen (wie bisher bei rbe)\n    isChange = true;\n} else if (ANALOG_TYPES.has(datatype) && typeof value === \"number\" && typeof prevValue === \"number\") {\n    // Numerischer Analogwert: Deadband-Vergleich\n    const overrideKey = `${msg.station}/${msg.tag}`;\n    const deadband = DEADBAND_OVERRIDES[overrideKey] ?? DEFAULT_DEADBAND;\n    isChange = Math.abs(value - prevValue) >= deadband;\n} else {\n    // Boolean, String, Byte, oder unbekannter Typ: exakte Gleichheit\n    isChange = value !== prevValue;\n}\n\nif (isChange) {\n    lastValues[key] = value;\n    flow.set(\"lastValues\", lastValues);\n    return msg;\n} else {\n    return null; // Nachricht verwerfen, keine Aenderung relevant\n}",
        "outputs": 1,
