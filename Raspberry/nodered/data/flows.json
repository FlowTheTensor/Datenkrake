        "id": "fn-build-read-msgs",
        "type": "function",
        "z": "tab-opcua-nodesauswahl",
        "name": "Read-Messages erzeugen",
        "func": "const items = flow.get(\"nodesAuswahlItems\") || [];\nif (!items.length) {\n node.status({ fill: \"yellow\", shape: \"ring\", text: \"Keine Nodes geladen\" });\n return null;\n}\n\nconst messages = items.map((it) => ({\n endpoint: it.endpoint,\n station: it.station,\n tag: it.tag,\n datatype: it.datatype,\n nodeId: it.nodeId,\n topic: it.nodeId,\n payload: \"\"\n}));\n\nreturn [messages];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 520,
        "wires": [
