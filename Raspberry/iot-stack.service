[Unit]
Description=IoT Stack (MQTT, DB, Web)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Vorlage: setup_iot_stack.sh erzeugt diese Datei mit dem tatsaechlichen Pfad.
# Kommentare in systemd-Dateien nur in eigenen Zeilen, nicht hinter Werten.
WorkingDirectory=/home/pi/Datenkrake-Container/Raspberry/compose
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target