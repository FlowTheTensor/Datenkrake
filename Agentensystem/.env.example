# -----------------------------------------------------------------------------
# Agentensystem environment template
# Copy to .env and adapt values for your network/environment.
# -----------------------------------------------------------------------------

# Poller source: "influx" (default) or "mariadb"
ANOMALIE_QUELLE=influx

# --- MariaDB (read + write path for anomaly workflow) ------------------------
DK_DB_HOST=datenkrake.local
DK_DB_PORT=3306
DK_DB_NAME=telemetry

# Read account (existing default in repo)
DK_READ_USER=mcp_read
DK_READ_PASSWORD=changeMeMcp

# Write account for anomalies/wartung events (existing default in repo)
DK_WRITE_USER=anomalie_writer
DK_WRITE_PASSWORD=changeMeAnomalie

# --- InfluxDB (read path for anomaly detection) -------------------------------
DK_INFLUX_URL=http://datenkrake.local:8086
DK_INFLUX_TOKEN=changeMeHistorianToken
DK_INFLUX_ORG=datenkrake
DK_INFLUX_BUCKET=telemetrie

# --- Lokales LLM (LM Studio, OpenAI-kompatibel) -------------------------------
# Gemeinsame Defaults fuer alle Agenten (shared/llm_client.py). Jeder Agent
# kann optional eigene <AGENT>_LLM_URL/-MODEL/-API_KEY/-TIMEOUT setzen, um
# diese Defaults zu ueberschreiben (siehe jeweiliger *_USE_LLM-Schalter unten).
LLM_BASE_URL=http://localhost:1234
LLM_MODEL=local-model
# Optionaler Bearer-Token fuer OpenAI-kompatible Endpunkte
LLM_API_KEY=
LLM_TIMEOUT=30

# --- DB-Agent (optionale LLM-Werkzeugwahl statt Keyword-Abgleich) ------------
DB_AGENT_USE_LLM=false
DB_AGENT_LLM_URL=
DB_AGENT_LLM_MODEL=
DB_AGENT_LLM_API_KEY=
DB_AGENT_LLM_TIMEOUT=

# --- Orchestrator-Agent (optionale LLM-Statusformulierung, KEINE Wartungs-
# oder Safety-Entscheidung - die bleibt immer regelbasiert) ------------------
ORCHESTRATOR_USE_LLM=false
ORCHESTRATOR_LLM_URL=
ORCHESTRATOR_LLM_MODEL=
ORCHESTRATOR_LLM_API_KEY=
ORCHESTRATOR_LLM_TIMEOUT=

# --- Wartungs-Agent (optionaler LLM-Kommentar zum Messergebnis, NICHT die
# Safety-Fence-Bestaetigung selbst - siehe wartungs_agent/__main__.py) -------
WARTUNGS_AGENT_USE_LLM=false
WARTUNGS_AGENT_LLM_URL=
WARTUNGS_AGENT_LLM_MODEL=
WARTUNGS_AGENT_LLM_API_KEY=
WARTUNGS_AGENT_LLM_TIMEOUT=

# --- Report-Agent (optionale LLM-Formulierung) ---------------------------------
# Keep false to use deterministic template formatting.
REPORT_USE_LLM=false
REPORT_LLM_URL=http://localhost:1234
REPORT_LLM_MODEL=local-model
# Optional bearer token for OpenAI-compatible endpoint
REPORT_LLM_API_KEY=
REPORT_LLM_TIMEOUT=30

# --- Vorausschauende Instandhaltung (ml_training/, optional) -----------------
# "zscore" (Standard, kein Training noetig) oder "isolation_forest" (erst nach
# Ausfuehren von ml_training/train_isolation_forest_akustik.py verfuegbar).
ANOMALIE_METHODE=zscore
