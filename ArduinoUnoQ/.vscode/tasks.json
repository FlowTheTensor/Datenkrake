{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Arduino App: Run",
      "type": "shell",
      "command": "arduino-app-cli",
      "args": [
        "app",
        "start",
        "${workspaceFolder}"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Arduino App: Stop",
      "type": "shell",
      "command": "arduino-app-cli",
      "args": [
        "app",
        "stop",
        "${workspaceFolder}"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
